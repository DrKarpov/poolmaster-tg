# Replace locally with a token from BotFather. Never commit or paste a real token.
TELEGRAM_BOT_TOKEN=replace_me
# Bot username without the leading @.
TELEGRAM_BOT_USERNAME=JETTONPOOL_BOT
# Comma-separated Telegram numeric user IDs. Empty means no admin access.
ADMIN_USER_IDS=
AUTO_PUSH_STATE_PATH=data/admin_state.json
PTB_TIMEDELTA=true
SUBSCRIBERS_PATH=data/subscribers.json
STATS_PATH=data/stats.json
MANAGED_DESTINATIONS_PATH=data/managed_destinations.json
USER_STATE_PATH=data/user_state.json
FARMING_CACHE_PATH=data/farming_cache.json
FARMING_HISTORY_PATH=data/farming_history.sqlite3
SNAPSHOT_CACHE_PATH=data/snapshot.json
GLOBAL_AUTO_PUSH_PAUSED=true
# Source refresh / freshness limits, in seconds.
FARMING_POLL_INTERVAL_SECONDS=300
FARMING_STALE_MAX_AGE_SECONDS=1800
# Relative change (%) that requires a second matching source sample before a farming anomaly is accepted.
APR_ANOMALY_CONFIRM_THRESHOLD=50
PRICE_POLL_INTERVAL_SECONDS=60
PRICE_SOURCE_MAX_AGE_SECONDS=300
PRICE_STALE_MAX_AGE_SECONDS=900
PRICE_ALERT_COOLDOWN_SECONDS=900
# Relative price change (%) that requires a second matching sample before an anomaly is accepted.
PRICE_ANOMALY_CONFIRM_THRESHOLD=20
UI_REFRESH_COOLDOWN_SECONDS=10
CHART_CACHE_DIR=data/chart_cache
CHART_STALE_MAX_AGE_SECONDS=1800
DELETE_COMMAND_MESSAGES=false
